<?xml version="1.0" encoding="utf-8"?>

<configuration>

	<connectionStrings>
		<add name="dbcon"
             connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=TripPlanner.mdf;Integrated Security=True;"></add>
	</connectionStrings>

	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.7.2" />
	</system.web>

</configuration>