<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Trip_Planer.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <title>Trip Planner</title>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <!-- GOOGLE FONT -->
    <link href="https://fonts.googleapis.com/css?family=Work+Sans:400,700,900&display=swap"
          rel="stylesheet" />

    <!-- CSS -->
    <link rel="stylesheet"
          href="<%= ResolveUrl("~/css/bootstrap.min.css") %>" />
    <a href="Site1.Master">Site1.Master</a>
    <link rel="stylesheet"
          href="<%= ResolveUrl("~/css/bootstrap-datepicker.css") %>" />

    <link rel="stylesheet"
          href="<%= ResolveUrl("~/css/jquery.fancybox.min.css") %>" />

    <link rel="stylesheet"
          href="<%= ResolveUrl("~/css/owl.carousel.min.css") %>" />

    <link rel="stylesheet"
          href="<%= ResolveUrl("~/css/owl.theme.default.min.css") %>" />

    <link rel="stylesheet"
          href="<%= ResolveUrl("~/css/aos.css") %>" />

    <link rel="stylesheet"
          href="<%= ResolveUrl("~/fonts/icomoon/style.css") %>" />

    <link rel="stylesheet"
          href="<%= ResolveUrl("~/fonts/flaticon/font/flaticon.css") %>" />

    <!-- MAIN CSS -->
    <link rel="stylesheet"
          href="<%= ResolveUrl("~/css/style.css") %>" />


    <!-- PAGE HEAD -->
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

</head>


<body>

<form id="form1" runat="server">


    <!-- ================= NAVBAR ================= -->

    <header class="site-navbar site-navbar-target"
            role="banner">

        <div class="container">

            <div class="row align-items-center position-relative">


                <!-- LOGO -->

                <div class="col-3">

                    <div class="site-logo">

                        <a href="<%= ResolveUrl("~/User/UserHome.aspx") %>"
                           class="font-weight-bold">

                            <img src="<%= ResolveUrl("~/images/logo.png") %>"
                                 alt="Trip Planner"
                                 class="img-fluid" />

                        </a>

                    </div>

                </div>


                <!-- MENU -->

                <div class="col-9 text-right">

                    <nav class="site-navigation text-right ml-auto"
                         role="navigation">

                        <ul class="site-menu main-menu js-clone-nav ml-auto">


                            <!-- HOME -->

                            <li>

                                <a href="<%= ResolveUrl("~/User/UserHome.aspx") %>"
                                   class="nav-link">

                                    Home

                                </a>

                            </li>


                            <!-- MY PROFILE -->

                            <li>

                                <a href="<%= ResolveUrl("~/User/MyProfile.aspx") %>"
                                   class="nav-link">

                                    My Profile

                                </a>

                            </li>


                            <!-- CREATE TRIP -->

                            <li>

                                <a href="<%= ResolveUrl("~/User/CreateTrip.aspx") %>"
                                   class="nav-link">

                                    Create Trip

                                </a>

                            </li>


                            <!-- MY TRIPS -->

                            <li>

                                <a href="<%= ResolveUrl("~/User/MyTrips.aspx") %>"
                                   class="nav-link">

                                    My Trips

                                </a>

                            </li>


                            <!-- DESTINATIONS -->

                            <li>

                                <a href="<%= ResolveUrl("~/User/Destinations.aspx") %>"
                                   class="nav-link">

                                    Destinations

                                </a>

                            </li>


                            <!-- FEEDBACK -->

                            <li>

                                <a href="<%= ResolveUrl("~/User/Feedback.aspx") %>"
                                   class="nav-link">

                                    Feedback

                                </a>

                            </li>


                            <!-- LOGOUT -->

                            <li>

                                <asp:HyperLink
                                    ID="lnkLogout"
                                    runat="server"
                                    NavigateUrl="~/Logout.aspx"
                                    CssClass="nav-link">

                                    Logout

                                </asp:HyperLink>

                            </li>


                        </ul>

                    </nav>

                </div>

            </div>

        </div>

    </header>


    <!-- ================= PAGE CONTENT 1 ================= -->

    <asp:ContentPlaceHolder
        ID="ContentPlaceHolder1"
        runat="server">

    </asp:ContentPlaceHolder>


    <!-- ================= PAGE CONTENT 2 ================= -->

    <asp:ContentPlaceHolder
        ID="ContentPlaceHolder2"
        runat="server">

    </asp:ContentPlaceHolder>


    <!-- ================= PAGE CONTENT 3 ================= -->

    <asp:ContentPlaceHolder
        ID="ContentPlaceHolder3"
        runat="server">

    </asp:ContentPlaceHolder>


</form>

</body>

</html>